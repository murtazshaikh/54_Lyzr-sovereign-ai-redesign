---
import { tiers } from "../data/optimus";
---

<section class="scale" id="optimus" style={`--count:${tiers.length}`}>
  <div class="shell">
    <div class="scale__head">
      <p class="label scale__eyebrow reveal">
        <span class="scale__dot" aria-hidden="true"></span>
        Lyzr Optimus
      </p>
      <h2 class="h2 scale__title reveal" style="--reveal-delay:60ms">
        Choose your scale. Own your intelligence
      </h2>
      <p class="lead scale__lead reveal" style="--reveal-delay:120ms">
        From a personal workstation for a CXO to an enterprise rack for
        10,000 concurrent users. Pick the appliance for the scale you need.
      </p>
    </div>

    <!-- The tiers are a scale, so the control is one: four stops on a
         track that fills up to wherever you are. -->
    <div
      class="rail reveal"
      style="--reveal-delay:180ms; --i:0"
      role="radiogroup"
      aria-label="Optimus tier"
    >
      <div class="rail__track" aria-hidden="true"><span class="rail__fill"></span></div>
      {tiers.map((t, i) => (
        <button
          class="stop"
          type="button"
          role="radio"
          data-stop={i}
          aria-checked={i === 0 ? "true" : "false"}
          aria-controls={`tier-${t.id}`}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="stop__dot" aria-hidden="true"></span>
          <span class="stop__name">Optimus {t.name}</span>
          <span class="stop__meta">{t.meta}</span>
        </button>
      ))}
    </div>

    <div class="tiers">
      {tiers.map((t, i) => (
        <article class="tier" id={`tier-${t.id}`} data-tier={i} hidden={i !== 0}>
          <div class="tier__intro">
            <span class="pill pill--dated">
              <span class="dot dot--ring"></span>
              Pre-orders opening Q4
            </span>
            <h3 class="tier__name">Optimus {t.name}</h3>
            <p class="tier__tagline">{t.tagline}</p>
            <a class="tier__cta" href="#cta">
              Join the Optimus waitlist <span class="arrow">&rarr;</span>
            </a>
          </div>

          <dl class="specs">
            {t.specs.map((s, n) => (
              <div class="spec" style={`--n:${n}`}>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .scale {
    padding-block: clamp(3.5rem, 1.5rem + 5vw, 7rem);
    border-top: 1px solid var(--line);
  }

  .scale__head {
    max-width: 62ch;
    margin-inline: auto;
    text-align: center;
  }
  .scale__eyebrow { display: inline-flex; align-items: center; gap: var(--s2); }
  .scale__dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--purple);
  }
  .scale__title { margin-top: var(--s3); max-width: 20ch; margin-inline: auto; }
  .scale__lead  { margin-top: var(--s5); }

  /* Rail --------------------------------------------------------- */
  .rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    margin-top: clamp(3rem, 1.5rem + 4vw, 5rem);
  }

  .rail__track {
    position: absolute;
    /* stops sit on a column centre, so the track spans centre to centre */
    left: calc(50% / var(--count));
    right: calc(50% / var(--count));
    top: 7px;
    height: 2px;
    background: var(--line-strong);
    border-radius: 2px;
  }
  /* The fill runs from the first stop to the active one. */
  .rail__fill {
    display: block;
    height: 100%;
    width: calc(var(--i) / (var(--count) - 1) * 100%);
    background: var(--purple);
    border-radius: 2px;
    transition: width var(--d-slow) var(--ease);
  }

  .stop {
    display: grid;
    justify-items: center;
    gap: var(--s2);
    padding: 0 var(--s2) var(--s2);
    background: none;
    border: 0;
    cursor: pointer;
    text-align: center;
    color: var(--ink-45);
    transition: color var(--d-mid) var(--ease);
  }

  .stop__dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 2px var(--line-strong);
    transition: box-shadow var(--d-mid) var(--ease),
                transform var(--d-mid) var(--ease);
  }
  /* Every stop up to and including the active one reads as reached. */
  .stop.is-passed .stop__dot { box-shadow: inset 0 0 0 2px var(--purple); }
  .stop[aria-checked="true"] .stop__dot {
    box-shadow: inset 0 0 0 5px var(--purple);
    transform: scale(1.25);
  }

  .stop__name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.018em;
  }
  .stop__meta { font-size: var(--t-small); }

  .stop:hover { color: var(--ink-70); }
  .stop[aria-checked="true"] { color: var(--ink); }

  /* Tier panels -------------------------------------------------- */
  .tiers {
    display: grid;
    margin-top: clamp(2rem, 1rem + 2.5vw, 3rem);
  }

  .tier {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    padding: clamp(1.75rem, 1rem + 2.4vw, 3rem);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--r-lg);
  }
  .tier[hidden] { display: none; }

  .tier__name {
    margin-top: var(--s4);
    font-size: clamp(1.5rem, 1.15rem + 1.4vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.032em;
    line-height: 1.1;
  }
  .tier__tagline {
    margin-top: var(--s3);
    color: rgba(255, 255, 255, 0.62);
    max-width: 30ch;
  }
  .tier__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-top: var(--s6);
    font-weight: 600;
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 5px;
    transition: text-decoration-color var(--d-fast) var(--ease);
  }
  .tier__cta:hover { text-decoration-color: var(--paper); }
  .tier__cta .arrow { transition: transform var(--d-fast) var(--ease); }
  .tier__cta:hover .arrow { transform: translateX(3px); }

  /* Specs -------------------------------------------------------- */
  .specs { display: grid; align-content: center; }

  .spec {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s5);
    padding-block: var(--s4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .spec:first-child { padding-top: 0; }
  .spec:last-child { border-bottom: 0; padding-bottom: 0; }

  .spec dt {
    font-size: var(--t-small);
    color: rgba(255, 255, 255, 0.55);
  }
  /* Spec values are set in the system monospace stack. It costs no
     bytes and gives the numbers the feel of a hardware sheet. */
  .spec dd {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.875rem;
    letter-spacing: -0.01em;
    text-align: right;
    color: var(--paper);
  }

  /* Rows arrive in sequence when the tier changes, so the eye reads
     the sheet top to bottom instead of the block appearing at once. */
  .tier.is-entering .spec,
  .tier.is-entering .tier__intro > * {
    animation: spec-in 460ms var(--ease) both;
    animation-delay: calc(var(--n, 0) * 45ms);
  }
  .tier.is-entering .tier__intro > * { --n: 0; }
  @keyframes spec-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 860px) {
    .tier { grid-template-columns: 1fr; }
    .stop__name { font-size: var(--t-small); }
    .stop__meta { display: none; }
  }
  @media (max-width: 520px) {
    .rail { gap: var(--s2); }
    .stop { padding-inline: 0; }
    .stop__name { font-size: 0.8125rem; letter-spacing: -0.02em; }
    .spec { flex-direction: column; align-items: flex-start; gap: var(--s1); }
    .spec dd { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__fill { transition: none; }
    .tier.is-entering .spec,
    .tier.is-entering .tier__intro > * { animation: none; }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>(".scale .rail");
  if (rail) {
    const stops = [...rail.querySelectorAll<HTMLButtonElement>("[data-stop]")];
    const panels = [...document.querySelectorAll<HTMLElement>("[data-tier]")];
    let current = 0;

    function select(next: number) {
      current = next;
      rail.style.setProperty("--i", String(next));

      stops.forEach((s, i) => {
        s.setAttribute("aria-checked", String(i === next));
        s.tabIndex = i === next ? 0 : -1;
        s.classList.toggle("is-passed", i <= next);
      });

      panels.forEach((p, i) => {
        p.hidden = i !== next;
        p.classList.remove("is-entering");
      });
      // reflow so the stagger replays on every change
      void panels[next].offsetWidth;
      panels[next].classList.add("is-entering");
    }

    stops.forEach((stop, i) => {
      stop.addEventListener("click", () => select(i));
      stop.addEventListener("keydown", (e) => {
        const delta = { ArrowRight: 1, ArrowUp: 1, ArrowLeft: -1, ArrowDown: -1 }[e.key];
        if (delta === undefined) {
          if (e.key === "Home") { e.preventDefault(); select(0); stops[0].focus(); }
          if (e.key === "End") {
            e.preventDefault();
            select(stops.length - 1);
            stops[stops.length - 1].focus();
          }
          return;
        }
        e.preventDefault();
        // Move relative to the stop that has focus, not a stored index,
        // so the keys behave correctly however focus arrived here.
        const next = Math.min(stops.length - 1, Math.max(0, i + delta));
        select(next);
        stops[next].focus();
      });
    });

    select(0);
  }
</script>
