---
import { marks } from "../data/marks";

const partners = [
  { name: "Amazon Web Services", svg: marks.aws },
  { name: "Google Cloud", svg: marks.gcp },
  { name: "Microsoft Azure", svg: marks.azure },
  { name: "NVIDIA", svg: marks.nvidia },
];
---

<div class="partners">
  <p class="partners__lede">
    Running in production at <strong>500+</strong> enterprises, on the
    clouds you already run on
  </p>
  <ul class="partners__row">
    {partners.map((p) => (
      <li class="partners__item">
        <Fragment set:html={p.svg} />
        <span class="partners__name">{p.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .partners {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 0.5rem + 3vw, 3.5rem);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }

  .partners__lede {
    font-size: var(--t-small);
    color: var(--ink-45);
    max-width: 28ch;
  }
  .partners__lede strong { color: var(--ink); font-weight: 600; }

  .partners__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s4) clamp(1.5rem, 0.5rem + 2.4vw, 2.75rem);
  }

  .partners__item {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    color: var(--ink);
    opacity: 0.52;
    transition: opacity var(--d-mid) var(--ease);
  }
  /* The row dims as a group on hover and resolves to the one under
     the cursor. */
  .partners__row:hover .partners__item { opacity: 0.26; }
  .partners__row .partners__item:hover { opacity: 1; }

  .partners__item :global(.mark) { width: 17px; height: 17px; flex: none; }

  .partners__name {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .partners { grid-template-columns: 1fr; gap: var(--s4); }
  }
</style>
