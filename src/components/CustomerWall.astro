---
import { customers } from "../data/customers";
import { ekg } from "../data/ekg";

// Partners belong in the Partners menu, not on a board of who is
// running agents in production.
const running = customers.filter((c) => !c.partner);
const slug = (n: string) => n.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<svg class="sprite" aria-hidden="true" focusable="false">
  <defs>
    {running.map((c) => <g id={`mark-${slug(c.name)}`} set:html={c.body} />)}
  </defs>
</svg>

<section class="proof" id="proof">
  <div class="shell">
    <div class="proof__head">
      <p class="label proof__eyebrow reveal">
        <span class="proof__rule" aria-hidden="true"></span>
        In production right now
      </p>
      <h2 class="h2 proof__title split" style="--reveal-delay:60ms">
        Enterprises running on the Lyzr sovereign agent platform
      </h2>
    </div>

    <!-- A board, not a belt. A sliding logo strip is decoration; this
         says who is running, in what sector, and that it is live. -->
    <div class="board reveal" style="--reveal-delay:100ms">
      <div class="board__head" aria-hidden="true">
        <span>Enterprise</span>
        <span>Sector</span>
        <span class="board__status-col">Status</span>
      </div>

      <ol class="board__rows">
        {running.map((c, i) => (
          <li class="brow" style={`--beat-offset:${i * 380}ms; --n:${i}`}>
            <span class="brow__logo">
              <svg viewBox={c.viewBox} style={`--cap:${c.cap}px`} fill="currentColor" role="img" aria-label={c.name}>
                <use href={`#mark-${slug(c.name)}`} />
              </svg>
            </span>
            <span class="brow__sector">{c.sector}</span>
            <span class="brow__status">
              <span class="pill pill--live">
                <Fragment set:html={ekg} />
                Live
              </span>
            </span>
          </li>
        ))}
      </ol>

      <p class="board__foot">
        <span class="board__figure">
          <span data-count="1000">1,000</span><span class="board__plus">+</span>
        </span>
        {" "}agents live in production across{" "}
        <span class="board__figure">
          <span data-count="500">500</span><span class="board__plus">+</span>
        </span>{" "}
        enterprises
      </p>
    </div>
  </div>
</section>

<style>
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

  .proof {
    padding-block: clamp(3.5rem, 1.5rem + 4vw, 6rem);
    background: var(--wash);
    border-top: 1px solid var(--line);
  }

  .proof__head { text-align: center; }
  .proof__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
  }
  .proof__rule { width: 22px; height: 2px; background: var(--purple); }
  .proof__title {
    margin: var(--s3) auto 0;
    max-width: 24ch;
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.125rem);
    line-height: 1.15;
  }

  /* Board -------------------------------------------------------- */
  .board {
    max-width: 880px;
    margin: clamp(2rem, 1rem + 2.5vw, 3rem) auto 0;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .board__head,
  .brow {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s5);
    padding: var(--s4) clamp(1.25rem, 0.75rem + 1.4vw, 1.75rem);
  }

  .board__head {
    padding-block: var(--s3);
    border-bottom: 1px solid var(--line);
    background: var(--wash);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-45);
  }
  .board__status-col { justify-self: end; }

  .brow {
    border-bottom: 1px solid var(--line);
    transition: background var(--d-mid) var(--ease);
    position: relative;
  }
  .brow:last-child { border-bottom: 0; }
  /* A monitoring row lights when you point at it. */
  .brow::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--live-dot);
    transform: scaleY(0);
    transition: transform var(--d-mid) var(--ease);
  }
  .brow:hover { background: var(--wash); }
  .brow:hover::before { transform: scaleY(1); }

  .brow__logo { display: flex; align-items: center; color: var(--ink); }
  .brow__logo svg {
    height: var(--cap);
    width: auto;
    opacity: 0.82;
    transition: opacity var(--d-mid) var(--ease);
  }
  .brow:hover .brow__logo svg { opacity: 1; }

  .brow__sector { font-size: var(--t-small); color: var(--ink-45); }
  .brow__status { justify-self: end; }

  /* Foot --------------------------------------------------------- */
  .board__foot {
    padding: var(--s5) clamp(1.25rem, 0.75rem + 1.4vw, 1.75rem);
    border-top: 1px solid var(--line-strong);
    background: var(--wash);
    font-size: var(--t-small);
    color: var(--ink-45);
    text-align: center;
  }
  .board__figure {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .board__plus { color: var(--purple); }

  @media (max-width: 680px) {
    .board__head { display: none; }
    .brow {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: var(--s2);
    }
    .brow__sector { grid-column: 1; grid-row: 2; }
    .brow__status { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
