---
import { nav } from "../data/nav";
import { icons } from "../data/icons";
import MenuLink from "./MenuLink.astro";

const chev = `<svg class="chev" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 3.75 5 6.25l2.5-2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<aside class="announce" aria-label="Announcement">
  <div class="shell announce__inner">
    <span class="announce__new">
      <span class="beacon" aria-hidden="true"></span>
      New
    </span>
    <span class="announce__sep" aria-hidden="true"></span>
    <span class="announce__text">Lyzr launches the Control Plane for AI Agents</span>
    <span class="announce__text announce__text--short">Control Plane is live</span>
    <span class="announce__sep announce__sep--cta" aria-hidden="true"></span>
    <a class="announce__link" href="#full-stack">Access now <span class="arrow">&rarr;</span></a>
  </div>
</aside>

<div class="scrim" data-scrim aria-hidden="true"></div>

<header class="head">
  <div class="shell head__inner">
    <!-- One box sits behind every panel. It is what actually moves and
         resizes between menus, which is why the surface appears to stay
         open and morph rather than closing and reopening. -->
    <div class="megabox" data-box aria-hidden="true"></div>
    <a class="brand" href="/" aria-label="Lyzr home">
      <img
        class="brand__logo"
        src="/images/lyzr-ink.webp"
        width="240"
        height="93"
        alt="Lyzr"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item, i) =>
        item.columns ? (
          <div class="nav__item">
            <button
              class="nav__link nav__trigger"
              type="button"
              aria-expanded="false"
              aria-controls={`menu-${i}`}
            >
              {item.label}
              <Fragment set:html={chev} />
            </button>

            <div class={`menu menu--${item.size ?? "md"}`} id={`menu-${i}`}>
              <div class:list={["menu__grid", { "menu__grid--panel-first": item.columns[0].panel }]} style={`--cols:${item.columns.length}`}>
                {item.columns.map((col) => (
                  <div class:list={["menu__col", { "menu__col--panel": col.panel }]}>
                    <p class="menu__title">{col.title}</p>
                    <ul class="menu__list">
                      {col.links.map((l) => (
                        <li><MenuLink link={l} /></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              {item.featured && (
                <div class="menu__featured">
                  <p class="menu__title">Featured</p>
                  <div class="menu__cards">
                    {item.featured.map((f) => (
                      <div class="fcard">
                        <span class="fcard__play" set:html={icons.play} />
                        <span class="fcard__body">
                          <span class="fcard__source">{f.source}</span>
                          <span class="fcard__title">{f.title}</span>
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        ) : (
          <a class="nav__link" href={item.href}>{item.label}</a>
        )
      )}
    </nav>

    <div class="head__actions">
      <a class="head__usecases" href="#full-stack">
        <svg class="head__star" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M6 1.2l1.45 2.95 3.25.47-2.35 2.3.55 3.23L6 8.62l-2.9 1.53.55-3.23L1.3 4.62l3.25-.47z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
        </svg>
        Agent Usecases
      </a>
      <a class="btn btn--ghost btn--sm" href="#full-stack">Agent Studio</a>
      <a class="btn btn--primary btn--sm" href="#cta">Talk to Us</a>
    </div>

    <button class="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span>
    </button>
  </div>

  <div class="mobile" id="mobile-nav" hidden>
    <div class="shell">
      <nav class="mnav" aria-label="Mobile">
        {nav.map((item) =>
          item.columns ? (
            <details class="mnav__group">
              <summary class="mnav__summary">
                {item.label}
                <Fragment set:html={chev} />
              </summary>
              <div class="mnav__body">
                {item.columns.map((col) => (
                  <div class="mnav__col">
                    <p class="menu__title">{col.title}</p>
                    <ul class="mnav__list">
                      {col.links.map((l) => (
                        <li>
                          <span class:list={["mnav__sub", { "is-muted": l.muted }]}>{l.label}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          ) : (
            <a class="mnav__link" href={item.href}>{item.label}</a>
          )
        )}
        <a class="mnav__link" href="#full-stack">Agent Usecases</a>
      </nav>
      <div class="mobile__actions">
        <a class="btn btn--ghost" href="#full-stack">Agent Studio</a>
        <a class="btn btn--primary" href="#cta">Talk to Us</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Announcement bar ------------------------------------------ */
  .announce {
    background: var(--ink);
    color: var(--paper);
    font-size: var(--t-small);
  }
  .announce__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s4);
    height: 40px;
  }
  /* "New" is a signal, not a control: a pulsing dot and a quiet
     letterspaced label. No fill, no border, nothing to press. */
  .announce__new {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }
  .beacon {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--purple);
  }
  .beacon::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--purple);
    animation: beacon 2.4s var(--ease) infinite;
  }
  @keyframes beacon {
    0%   { transform: scale(1);   opacity: 0.6; }
    100% { transform: scale(3.4); opacity: 0; }
  }
  .announce__sep {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.18);
  }
  .announce__text {
    color: rgba(255, 255, 255, 0.92);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .announce__text--short { display: none; }
  .announce__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-weight: 600;
    white-space: nowrap;
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.28);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--d-fast) var(--ease);
  }
  .announce__link:hover { text-decoration-color: var(--paper); }
  .announce__link .arrow { transition: transform var(--d-fast) var(--ease); }
  .announce__link:hover .arrow { transform: translateX(3px); }

  /* Everything below the header dims while a menu is open, which is
     what makes the panel read as a layer rather than a box. */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(19, 17, 42, 0.38);
    backdrop-filter: blur(1.5px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 320ms var(--ease),
                visibility 0s linear 320ms;
  }
  .scrim.is-on {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Header ----------------------------------------------------- */
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  /* The header sits above the scrim so it stays lit. */
  .head__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--s7);
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    flex: none;
  }
  /* Intrinsic size is declared so the header never shifts while the
     logo loads, and height drives the display size. */
  .brand__logo {
    height: 30px;
    width: auto;
  }

  /* Nav triggers ------------------------------------------------ */
  /* No gap between items. A gap means the pointer passes over dead
     space on its way from one trigger to the next, which closes the
     menu and reopens it. The spacing is padding on the links instead,
     so the hit areas touch and the travel is continuous. */
  .nav {
    display: flex;
    margin-inline: calc(var(--s3) * -1) auto;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: var(--s2) var(--s3);
    border: 0;
    background: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-70);
    cursor: pointer;
    position: relative;
    transition: color var(--d-fast) var(--ease);
  }
  /* The underline is inset by the padding so it still sits under the
     words rather than under the whole hit area. */
  .nav__link::after {
    content: "";
    position: absolute;
    left: var(--s3);
    right: var(--s3);
    bottom: 0;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--d-mid) var(--ease);
  }
  .nav__link:hover,
  .nav__trigger[aria-expanded="true"] { color: var(--ink); }
  .nav__link:hover::after,
  .nav__trigger[aria-expanded="true"]::after { transform: scaleX(1); }

  .nav__link :global(.chev) {
    width: 10px;
    height: 10px;
    opacity: 0.55;
    transition: opacity var(--d-fast) var(--ease),
                transform var(--d-mid) var(--ease);
  }
  .nav__link:hover :global(.chev) { opacity: 1; }
  .nav__trigger[aria-expanded="true"] :global(.chev) {
    opacity: 1;
    transform: rotate(180deg);
  }

  /* Menu panels ------------------------------------------------- */
  /* The morphing surface. Only this element carries the background,
     border and shadow, and only this element animates its geometry. */
  .megabox {
    position: absolute;
    top: 100%;
    left: 0;
    width: 0;
    height: 0;
    margin-top: -1px;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    box-shadow: 0 24px 60px -22px rgba(19, 17, 42, 0.28),
                0 1px 2px rgba(19, 17, 42, 0.05);
    opacity: 0;
    transform-origin: top center;
    transform: translateY(-6px) scaleY(0.97);
    pointer-events: none;
    z-index: 1;
    transition:
      opacity var(--d-mid) var(--ease),
      transform var(--d-mid) var(--ease),
      /* geometry is what makes it feel like one surface travelling */
      left 420ms var(--ease-out),
      width 420ms var(--ease-out),
      height 420ms var(--ease-out);
  }
  .megabox.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  /* First open has nothing to travel from, so the geometry must not
     animate in from zero. */
  .megabox.is-appearing { transition-property: opacity, transform; }

  .menu {
    position: absolute;
    top: 100%;
    left: var(--x, 0);
    margin-top: -1px;
    padding: var(--s6);
    z-index: 2;
    visibility: hidden;
    opacity: 0;
    /* content slides in from the side the reader came from */
    transform: translateX(var(--from, 0));
    /* The panels are siblings of the box, so nothing clips them while
       it resizes. clip-path does, and unlike width it does not reflow
       the content it is hiding. Matched to the box's own 420ms. */
    transition: opacity 220ms var(--ease),
                transform 340ms var(--ease-out),
                clip-path 420ms var(--ease-out),
                visibility 0s linear 220ms;
  }
  /* The incoming panel waits for the outgoing one to be gone. Two dense
     text panels at half opacity in the same place read as a smear, so
     the hand-off is sequential: out in 120ms, in from 150ms. The box
     is briefly empty, which is what makes the swap feel deliberate. */
  .menu.is-open {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 150ms, 150ms, 0s, 0s;
  }
  /* The outgoing panel leaves the other way, quickly. */
  .menu.is-leaving {
    visibility: visible;
    opacity: 0;
    transform: translateX(var(--to, 0));
    transition: opacity 120ms var(--ease-in),
                transform 220ms var(--ease-in),
                clip-path 420ms var(--ease-out),
                visibility 0s linear 420ms;
  }
  /* Invisible bridge so the pointer can cross from trigger to panel
     without a closing gap. */
  .menu::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 14px;
  }
  .menu--sm { width: 560px; }
  .menu--md { width: 780px; }
  .menu--lg { width: 1040px; }

  .menu__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: var(--s6);
  }
  .menu__grid--panel-first {
    grid-template-columns: minmax(0, 1.35fr) repeat(calc(var(--cols, 3) - 1), minmax(0, 1fr));
  }
  .menu__col--panel {
    background: var(--wash);
    border-radius: var(--r-md);
    padding: var(--s4);
    margin: calc(var(--s4) * -1);
    margin-right: 0;
  }
  .menu__col--panel + .menu__col { padding-left: var(--s2); }

  .menu__title {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-bottom: var(--s3);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-45);
  }
  .menu__title::before {
    content: "";
    width: 14px;
    height: 1.5px;
    background: var(--purple);
    opacity: 0.7;
  }

  .menu__list { display: grid; }


  /* Featured strip ---------------------------------------------- */
  .menu__featured {
    margin-top: var(--s6);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }
  .menu__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s4);
  }
  .fcard {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    padding: var(--s4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--wash);
    transition: border-color var(--d-fast) var(--ease),
                background var(--d-fast) var(--ease);
  }
  .fcard:hover { border-color: var(--line-strong); background: var(--wash-deep); }
  .fcard__play {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
  }
  .fcard__play :global(svg) { width: 14px; height: 14px; }
  .fcard__body { display: grid; gap: 3px; }
  .fcard__source {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-45);
  }
  .fcard__title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* Actions ------------------------------------------------------ */
  .head__actions {
    display: flex;
    align-items: center;
    gap: var(--s2);
    flex: none;
  }
  .head__usecases {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: var(--s1);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-70);
    transition: color var(--d-fast) var(--ease);
  }
  .head__usecases:hover { color: var(--ink); }
  .head__star { width: 13px; height: 13px; color: var(--purple); }

  /* Burger ------------------------------------------------------ */
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    margin-left: auto;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .burger span {
    width: 16px;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--d-mid) var(--ease);
  }
  .burger[aria-expanded="true"] span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .burger[aria-expanded="true"] span:last-child  { transform: translateY(-3.25px) rotate(-45deg); }

  /* Mobile panel ------------------------------------------------ */
  .mobile {
    border-top: 1px solid var(--line);
    background: var(--paper);
    padding-block: var(--s4) var(--s6);
    max-height: calc(100dvh - 104px);
    overflow-y: auto;
  }
  .mnav { display: grid; }
  .mnav__link,
  .mnav__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--s3);
    border-bottom: 1px solid var(--line);
    font-size: 1.0625rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .mnav__summary::-webkit-details-marker { display: none; }
  .mnav__summary :global(.chev) {
    width: 12px;
    height: 12px;
    opacity: 0.5;
    transition: transform var(--d-mid) var(--ease);
  }
  .mnav__group[open] .mnav__summary :global(.chev) { transform: rotate(180deg); }
  .mnav__body {
    display: grid;
    gap: var(--s5);
    padding: var(--s4) 0 var(--s5);
    border-bottom: 1px solid var(--line);
  }
  .mnav__list { display: grid; }
  .mnav__sub {
    display: block;
    padding-block: 6px;
    font-size: 0.9375rem;
    color: var(--ink-70);
  }
  .mnav__sub.is-muted { opacity: 0.42; pointer-events: none; }
  .mobile__actions {
    display: grid;
    gap: var(--s3);
    margin-top: var(--s5);
  }
  .mobile__actions .btn { justify-content: center; }

  @media (max-width: 1020px) {
    .nav, .head__actions { display: none; }
    .burger { display: flex; }
    .announce__text { display: none; }
    .announce__text--short { display: block; }
    .announce__sep--cta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .beacon::after { animation: none; }
    .menu, .megabox, .scrim { transition: none; transform: none; }
  }
</style>

<script>
  // ---- Desktop menus ---------------------------------------------
  // Hover opens after a short intent delay so crossing the nav does
  // not flicker panels. Click and keyboard open too. Escape, outside
  // pointer, or tabbing away closes. Panels clamp inside the shell.
  const shell = document.querySelector<HTMLElement>(".head__inner");
  const box = document.querySelector<HTMLElement>("[data-box]");
  const scrim = document.querySelector<HTMLElement>("[data-scrim]");
  const items = [...document.querySelectorAll<HTMLElement>(".nav__item")];
  let active: HTMLElement | null = null;
  let openTimer = 0;
  let closeTimer = 0;

  const parts = (item: HTMLElement) => ({
    trigger: item.querySelector<HTMLButtonElement>(".nav__trigger")!,
    menu: item.querySelector<HTMLElement>(".menu")!,
  });

  /** Left offset for a panel, clamped inside the shell. */
  function xFor(item: HTMLElement) {
    const { trigger, menu } = parts(item);
    const cs = getComputedStyle(shell!);
    const padL = parseFloat(cs.paddingLeft);
    const padR = parseFloat(cs.paddingRight);
    const max = shell!.clientWidth - padR - menu.offsetWidth;
    return Math.max(padL, Math.min(trigger.offsetLeft - 12, max));
  }

  /** Measure a panel without showing it. */
  function sizeOf(menu: HTMLElement) {
    return { w: menu.offsetWidth, h: menu.offsetHeight };
  }

  type Rect = { x: number; w: number; h: number };
  let boxRect: Rect | null = null;

  /**
   * The box rect expressed as an inset on a panel sitting at `panel`.
   * Both share a top edge, so only left, right and bottom matter.
   */
  function insetOf(panel: Rect, target: Rect) {
    const l = Math.max(0, target.x - panel.x);
    const r = Math.max(0, panel.x + panel.w - (target.x + target.w));
    const b = Math.max(0, panel.h - target.h);
    return `inset(0px ${r}px ${b}px ${l}px round 0 0 8px 8px)`;
  }

  function close() {
    if (!active) return;
    const { trigger, menu } = parts(active);
    trigger.setAttribute("aria-expanded", "false");
    menu.classList.remove("is-open");
    menu.style.removeProperty("--from");
    menu.style.removeProperty("clip-path");
    box?.classList.remove("is-open");
    scrim?.classList.remove("is-on");
    active = null;
    boxRect = null;
  }

  function open(item: HTMLElement) {
    if (active === item) return;
    const first = !active;
    const prev = active;
    const { trigger, menu } = parts(item);

    // Direction of travel, so the incoming panel enters from the side
    // the reader moved from and the outgoing one leaves the other way.
    const dir = prev ? (items.indexOf(item) > items.indexOf(prev) ? 1 : -1) : 0;

    const x = xFor(item);
    const { w, h } = sizeOf(menu);
    const next: Rect = { x, w, h };
    const from = boxRect;

    if (prev) {
      const p = parts(prev);
      p.trigger.setAttribute("aria-expanded", "false");
      p.menu.classList.remove("is-open");
      p.menu.style.setProperty("--to", `${dir * -18}px`);
      p.menu.classList.add("is-leaving");
      // Shrink the outgoing panel's clip to the box's destination, so
      // its content never hangs outside the box while it contracts.
      if (from) {
        p.menu.style.clipPath = "inset(0px)";
        void p.menu.offsetWidth;
        p.menu.style.clipPath = insetOf(from, next);
      }
      const leaving = p.menu;
      window.setTimeout(() => {
        leaving.classList.remove("is-leaving");
        leaving.style.removeProperty("clip-path");
      }, 440);
    }

    menu.style.setProperty("--x", `${x}px`);
    menu.style.setProperty("--from", `${dir * 18}px`);

    // The incoming panel starts clipped to wherever the box is now and
    // opens out with it, so a growing box never reveals content early.
    if (from) {
      menu.style.clipPath = insetOf(next, from);
      void menu.offsetWidth;
      menu.style.clipPath = "inset(0px)";
    } else {
      menu.style.removeProperty("clip-path");
    }

    if (box) {
      // On the very first open there is nowhere to travel from, so the
      // geometry is placed instantly and only opacity animates.
      box.classList.toggle("is-appearing", first);
      if (first) {
        box.style.left = `${x}px`;
        box.style.width = `${w}px`;
        box.style.height = `${h}px`;
        void box.offsetWidth;
      } else {
        box.style.left = `${x}px`;
        box.style.width = `${w}px`;
        box.style.height = `${h}px`;
      }
      box.classList.add("is-open");
    }
    boxRect = next;

    trigger.setAttribute("aria-expanded", "true");
    menu.classList.add("is-open");
    scrim?.classList.add("is-on");
    active = item;
  }

  for (const item of items) {
    const { trigger } = parts(item);

    item.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      clearTimeout(closeTimer);
      openTimer = window.setTimeout(() => open(item), 60);
    });
    item.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      clearTimeout(openTimer);
      closeTimer = window.setTimeout(close, 140);
    });
    trigger.addEventListener("click", () => (active === item ? close() : open(item)));
    item.addEventListener("focusout", (e) => {
      if (!item.contains(e.relatedTarget as Node)) close();
    });
  }

  // Leaving the panel itself closes too, and the scrim is a click target
  // for dismissing without moving the pointer back up.
  box?.addEventListener("pointerenter", () => clearTimeout(closeTimer));
  box?.addEventListener("pointerleave", () => {
    closeTimer = window.setTimeout(close, 140);
  });
  scrim?.addEventListener("pointerdown", close);

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || !active) return;
    parts(active).trigger.focus();
    close();
  });
  document.addEventListener("pointerdown", (e) => {
    if (active && !active.contains(e.target as Node)) close();
  });
  window.addEventListener("resize", () => {
    if (!active) return;
    const { menu } = parts(active);
    const x = xFor(active);
    const { w, h } = sizeOf(menu);
    menu.style.setProperty("--x", `${x}px`);
    if (box) { box.style.left = `${x}px`; box.style.width = `${w}px`; box.style.height = `${h}px`; }
    boxRect = { x, w, h };
  }, { passive: true });

  // ---- Mobile panel ----------------------------------------------
  const burger = document.querySelector<HTMLButtonElement>(".burger");
  const panel = document.querySelector<HTMLElement>("#mobile-nav");

  burger?.addEventListener("click", () => {
    const isOpen = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!isOpen));
    burger.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
    if (panel) panel.hidden = isOpen;
  });
  panel?.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest("a");
    if (!a || a.getAttribute("href") === "#") return;
    burger?.setAttribute("aria-expanded", "false");
    panel.hidden = true;
  });
</script>
