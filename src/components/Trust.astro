---
import { awards, certifications } from "../data/trust";
import { icons } from "../data/icons";
import { laurel } from "../data/laurel";
---

<section class="trust" id="trust">
  <div class="shell">
    <p class="label trust__label reveal">Recognized by leading analysts</p>

    <ol class="awards">
      {awards.map((a, i) => (
        <li class="award reveal" style={`--reveal-delay:${i * 50}ms`}>
          <span class="award__wreath" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="currentColor" set:html={laurel} />
            <span class="award__title">{a.title}</span>
          </span>
          <p class="award__source">{a.source}</p>
        </li>
      ))}
    </ol>

    <div class="certs">
      <p class="label trust__label trust__label--rule reveal">
        <span class="trust__rule" aria-hidden="true"></span>
        Security and compliance
      </p>
      <ul class="certs__row">
        {certifications.map((c, i) => (
          <li class="cert reveal" style={`--reveal-delay:${i * 60}ms`}>
            <span class="cert__ico" set:html={icons[c.icon]} />
            {c.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(3.5rem, 1.5rem + 5vw, 6rem);
    border-top: 1px solid var(--line);
  }

  .trust__label { text-align: center; }
  .trust__label--rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
  }
  .trust__rule { width: 22px; height: 2px; background: var(--purple); }

  /* Awards ------------------------------------------------------- */
  .awards {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s4);
    margin-top: clamp(2rem, 1rem + 2.5vw, 3rem);
  }

  .award {
    display: grid;
    justify-items: center;
    gap: var(--s3);
    text-align: center;
  }

  /* The wreath wraps the award title, so the laurel frames the claim
     the way an award badge does rather than sitting beside it. */
  .award__wreath {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 88px;
    color: var(--ink-45);
    transition: color var(--d-mid) var(--ease);
  }
  .award__wreath svg {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: 106px;
    height: 106px;
    opacity: 0.55;
    transition: opacity var(--d-mid) var(--ease),
                scale var(--d-mid) var(--ease);
  }
  /* The title sits inside the wreath, so its measure has to stay
     narrower than the wreath's inner opening or the words collide
     with the leaves. */
  .award__title {
    position: relative;
    max-width: 5.75rem;
    font-size: 0.6875rem;
    line-height: 1.25;
    font-weight: 500;
    color: var(--ink-70);
    text-wrap: balance;
  }
  .award:hover .award__wreath { color: var(--purple); }
  .award:hover .award__wreath svg { opacity: 1; scale: 1.05; }

  .award__source {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* Certifications ----------------------------------------------- */
  .certs {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-top: clamp(2rem, 1rem + 2.5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .certs__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s3) clamp(1rem, 0.5rem + 1.6vw, 1.75rem);
    margin-top: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
  }

  .cert {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--s4);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-70);
    transition: border-color var(--d-fast) var(--ease),
                color var(--d-fast) var(--ease);
  }
  .cert:hover { border-color: var(--purple); color: var(--ink); }
  .cert__ico { display: grid; place-items: center; width: 16px; height: 16px; color: var(--purple); }
  .cert__ico :global(svg) { width: 100%; height: 100%; }

  @media (max-width: 900px) {
    .awards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6) var(--s4); }
  }
  @media (max-width: 520px) {
    .awards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .award__wreath svg { width: 84px; height: 84px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .award__wreath svg { transition: none; }
  }
</style>
