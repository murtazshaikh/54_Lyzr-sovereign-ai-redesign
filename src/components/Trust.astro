---
import { awards, certifications } from "../data/trust";
import { complianceIcons } from "../data/icons";

// The badge strip is one image, so the recognitions still have to reach
// a screen reader somehow. The data builds the alt text.
const badgeAlt =
  "Recognized by leading analysts: " +
  awards.map((a) => `${a.source}, ${a.title}`).join("; ") + ".";
---

<section class="trust" id="trust">
  <div class="shell">
    <p class="label trust__label reveal">Recognized by leading analysts</p>

    <img
      class="badges reveal"
      src="/images/analyst-badges.webp"
      width="1202"
      height="145"
      alt={badgeAlt}
      loading="lazy"
      decoding="async"
      style="--reveal-delay:60ms"
    />

    <div class="certs">
      <p class="label trust__label trust__label--rule reveal">
        <span class="trust__rule" aria-hidden="true"></span>
        Security and compliance
      </p>
      <ul class="certs__grid">
        {certifications.map((c, i) => (
          <li class="cert reveal" style={`--reveal-delay:${i * 60}ms`}>
            <span class="cert__ico" set:html={complianceIcons[c.icon]} />
            <span class="cert__label">{c.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(3.5rem, 1.5rem + 5vw, 6rem);
    border-top: 1px solid var(--line);
  }

  .trust__label { text-align: center; }
  .trust__label--rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
  }
  .trust__rule { width: 22px; height: 2px; background: var(--purple); }

  /* Badge strip -------------------------------------------------- */
  /* Lyzr's own badge artwork, recoloured for a white page: the source
     is near-white on transparent, built for a dark background. Shipped
     at 1400px wide, which is 17KB and still crisp at the ~1100px it
     renders at. */
  .badges {
    display: block;
    width: 100%;
    /* 601px is the width Lyzr's own page renders this at, and a 1202px
       source makes that exactly 2x for a retina screen. */
    max-width: 601px;
    height: auto;
    margin: clamp(1.75rem, 1rem + 2vw, 2.75rem) auto 0;
  }

  /* Certifications ----------------------------------------------- */
  .certs {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-top: clamp(2rem, 1rem + 2.5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  /* A grid of large outlined marks over centred labels, matching the
     source layout, rather than the chips this was before. */
  .certs__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 2.5vw, 3rem) var(--s4);
    margin-top: clamp(2rem, 1rem + 2.5vw, 3rem);
  }

  .cert {
    display: grid;
    justify-items: center;
    gap: var(--s4);
    text-align: center;
  }

  .cert__ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    color: var(--ink-45);
    transition: color var(--d-mid) var(--ease),
                transform var(--d-mid) var(--ease);
  }
  /* The stroke is thinned at this size; 1.6 on a 24 viewBox reads
     heavy once the mark is 46px across. */
  .cert__ico :global(svg) {
    width: 100%;
    height: 100%;
    stroke-width: 1.3;
  }
  .cert:hover .cert__ico { color: var(--purple); transform: translateY(-2px); }

  .cert__label {
    font-size: var(--t-small);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-70);
    text-wrap: balance;
  }

  @media (max-width: 760px) {
    .certs__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 460px) {
    .certs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cert__ico { width: 40px; height: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cert:hover .cert__ico { transform: none; }
  }
</style>
