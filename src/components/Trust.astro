---
import { awards, certifications } from "../data/trust";
import { icons } from "../data/icons";

// The badge strip is one image, so the recognitions still have to reach
// a screen reader somehow. The data builds the alt text.
const badgeAlt =
  "Recognized by leading analysts: " +
  awards.map((a) => `${a.source}, ${a.title}`).join("; ") + ".";
---

<section class="trust" id="trust">
  <div class="shell">
    <p class="label trust__label reveal">Recognized by leading analysts</p>

    <img
      class="badges reveal"
      src="/images/analyst-badges.webp"
      width="1400"
      height="169"
      alt={badgeAlt}
      loading="lazy"
      decoding="async"
      style="--reveal-delay:60ms"
    />

    <div class="certs">
      <p class="label trust__label trust__label--rule reveal">
        <span class="trust__rule" aria-hidden="true"></span>
        Security and compliance
      </p>
      <ul class="certs__row">
        {certifications.map((c, i) => (
          <li class="cert reveal" style={`--reveal-delay:${i * 60}ms`}>
            <span class="cert__ico" set:html={icons[c.icon]} />
            {c.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(3.5rem, 1.5rem + 5vw, 6rem);
    border-top: 1px solid var(--line);
  }

  .trust__label { text-align: center; }
  .trust__label--rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
  }
  .trust__rule { width: 22px; height: 2px; background: var(--purple); }

  /* Badge strip -------------------------------------------------- */
  /* Lyzr's own badge artwork, recoloured for a white page: the source
     is near-white on transparent, built for a dark background. Shipped
     at 1400px wide, which is 17KB and still crisp at the ~1100px it
     renders at. */
  .badges {
    display: block;
    width: 100%;
    max-width: 1100px;
    height: auto;
    margin: clamp(1.75rem, 1rem + 2vw, 2.75rem) auto 0;
  }

  /* Certifications ----------------------------------------------- */
  .certs {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-top: clamp(2rem, 1rem + 2.5vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .certs__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s3) clamp(1rem, 0.5rem + 1.6vw, 1.75rem);
    margin-top: clamp(1.5rem, 1rem + 1.6vw, 2.25rem);
  }

  .cert {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--s4);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-70);
    transition: border-color var(--d-fast) var(--ease),
                color var(--d-fast) var(--ease);
  }
  .cert:hover { border-color: var(--purple); color: var(--ink); }
  .cert__ico { display: grid; place-items: center; width: 16px; height: 16px; color: var(--purple); }
  .cert__ico :global(svg) { width: 100%; height: 100%; }

  @media (max-width: 900px) {
    .awards { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6) var(--s4); }
  }
  @media (max-width: 520px) {
    .awards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .award__wreath svg { width: 84px; height: 84px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .award__wreath svg { transition: none; }
  }
</style>
