---
import { resources } from "../data/resources";
---

<section class="res" id="resources">
  <div class="shell">
    <div class="res__head">
      <p class="label res__eyebrow reveal">
        <span class="res__rule" aria-hidden="true"></span>
        Resources
      </p>
      <h2 class="h2 res__title split" style="--reveal-delay:60ms">
        Take something with you
      </h2>
      <p class="lead res__lead reveal" style="--reveal-delay:120ms">
        Playbooks, deep research, and real-world stories from the front
        lines of enterprise AI deployment.
      </p>
    </div>

    <ol class="cards">
      {resources.map((r, i) => (
        <li
          class:list={["rcard", { "rcard--featured": r.featured }]}
          style={`--reveal-delay:${i * 90}ms`}
        >
          <a class="rcard__link reveal" href="#cta" style={`--reveal-delay:${i * 90}ms`}>
            <!-- The cover is typeset, not photographed. A real book
                 mockup would be a 200KB image per card for something
                 that is, in the end, a title on a panel. -->
            <span class="cover" aria-hidden="true">
              <img
                class="cover__mark"
                src="/images/lyzr-white.webp"
                width="240"
                height="93"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="cover__type">
                <span class="cover__lead">{r.coverLead}</span>
                <span class="cover__accent">{r.coverAccent}</span>
              </span>
              <span class="cover__spine"></span>
            </span>

            <span class="rcard__body">
              <span class="rcard__kind">{r.kind}</span>
              <h3 class="rcard__title">{r.title}</h3>
              <p class="rcard__blurb">{r.blurb}</p>
              <span class="rcard__cta">
                {r.cta}
                <svg class="rcard__arrow" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3.5 10.5 10.5 3.5M4.9 3.5h5.6v5.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .res {
    padding-block: clamp(3.5rem, 1.5rem + 5vw, 7rem);
    background: var(--wash);
    border-top: 1px solid var(--line);
  }

  .res__head { max-width: 56ch; }
  .res__eyebrow { display: inline-flex; align-items: center; gap: var(--s3); }
  .res__rule { width: 22px; height: 2px; background: var(--purple); }
  .res__title { margin-top: var(--s3); }
  .res__lead { margin-top: var(--s4); max-width: 46ch; }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 0.5rem + 2vw, 2rem);
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .rcard__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color var(--d-mid) var(--ease),
                box-shadow var(--d-mid) var(--ease),
                transform var(--d-mid) var(--ease);
  }
  .rcard__link:hover {
    border-color: rgba(116, 88, 232, 0.45);
    box-shadow: 0 16px 40px -22px rgba(19, 17, 42, 0.4);
    transform: translateY(-3px);
  }

  /* Cover -------------------------------------------------------- */
  .cover {
    position: relative;
    display: grid;
    align-content: space-between;
    aspect-ratio: 4 / 3;
    padding: var(--s5);
    background:
      radial-gradient(120% 100% at 80% 0%, rgba(116, 88, 232, 0.22) 0%, rgba(116, 88, 232, 0) 60%),
      var(--ink);
    color: var(--paper);
    overflow: hidden;
  }
  /* A faint vertical rule stands in for a book spine, which is what
     makes the panel read as a cover rather than a coloured box. */
  .cover__spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(1.5rem, 1rem + 1.4vw, 2.25rem);
    width: 1px;
    background: rgba(255, 255, 255, 0.14);
  }

  .cover__mark {
    height: 20px;
    width: auto;
    justify-self: end;
  }

  .cover__type { display: grid; gap: 2px; }
  .cover__lead,
  .cover__accent {
    font-size: clamp(1.125rem, 0.85rem + 1.1vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .cover__accent { color: #b7a6ff; }

  /* Body --------------------------------------------------------- */
  .rcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.25rem, 0.75rem + 1.4vw, 1.75rem);
  }
  .rcard__kind {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--purple-ink);
  }
  .rcard__title {
    margin-top: var(--s3);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .rcard__blurb {
    margin-top: var(--s3);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--ink-45);
    text-wrap: pretty;
  }
  .rcard__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    margin-top: auto;
    padding-top: var(--s5);
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--ink);
  }
  .rcard__arrow {
    width: 13px;
    height: 13px;
    transition: transform var(--d-fast) var(--ease);
  }
  .rcard__link:hover .rcard__arrow { transform: translate(2px, -2px); }
  .rcard__link:hover .rcard__cta { color: var(--purple-ink); }

  /* One card is inverted, the same anchor trick the story rail uses. */
  .rcard--featured .rcard__link { background: var(--ink); border-color: var(--ink); }
  .rcard--featured .rcard__title { color: var(--paper); }
  .rcard--featured .rcard__blurb { color: rgba(255, 255, 255, 0.6); }
  .rcard--featured .rcard__kind { color: #b7a6ff; }
  .rcard--featured .rcard__cta { color: var(--paper); }
  .rcard--featured .cover { border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .rcard--featured .rcard__link:hover .rcard__cta { color: #b7a6ff; }

  @media (max-width: 900px) {
    .cards { grid-template-columns: 1fr; max-width: 26rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rcard__link:hover { transform: none; }
  }
</style>
