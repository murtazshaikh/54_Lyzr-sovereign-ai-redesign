---
import { stats } from "../data/proof";
---

<section class="band" aria-label="Platform in numbers">
  <div class="shell">
    <dl class="band__grid">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--reveal-delay:${i * 70}ms`}>
          <dt class="stat__value">
            <span data-count={s.value}>{s.value.toLocaleString("en-US")}</span
            ><span class="stat__suffix">{s.suffix}</span>
          </dt>
          <dd class="stat__caption">{s.caption}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .band {
    padding-block: clamp(3rem, 1.5rem + 4vw, 5rem);
    border-top: 1px solid var(--line);
  }

  /* Five columns divided by hairlines rather than five bordered
     cards. The rules do the work a card outline would. */
  .band__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
  }

  .stat {
    padding-inline: clamp(1rem, 0.4rem + 1.6vw, 2rem);
    border-left: 1px solid var(--line);
  }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .stat:last-child  { padding-right: 0; }

  .stat__value {
    display: flex;
    align-items: baseline;
    font-size: clamp(2.25rem, 1.3rem + 3.1vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    /* Tabular figures stop the number jittering while it counts. */
    font-variant-numeric: tabular-nums;
  }
  .stat__suffix {
    font-size: 0.5em;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--purple);
    margin-left: 2px;
  }

  .stat__caption {
    margin: var(--s3) 0 0;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--ink-45);
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .band__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s7) 0;
    }
    .stat { padding-inline: var(--s5); }
    .stat:nth-child(odd) { padding-left: 0; border-left: 0; }
    .stat:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 460px) {
    .band__grid { grid-template-columns: 1fr; gap: var(--s6); }
    .stat, .stat:nth-child(odd) {
      padding: 0 0 var(--s6);
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
    .stat:last-child { padding-bottom: 0; border-bottom: 0; }
  }
</style>
