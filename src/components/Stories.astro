---
import { stories } from "../data/stories";

const chev = (dir: "prev" | "next") =>
  `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="${
    dir === "prev" ? "M9.6 3.6 5.2 8l4.4 4.4" : "M6.4 3.6 10.8 8l-4.4 4.4"
  }" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// The rail holds three copies of the set. The reader always sits in the
// middle one, and the position is quietly shifted by exactly one set
// whenever they wander into an outer copy, which is what makes the loop
// endless in both directions without a visible seam.
const COPIES = 3;
const copies = Array.from({ length: COPIES }, (_, c) => c);
---

<section class="stories" id="stories">
  <div class="shell stories__head">
    <div class="stories__intro">
      <p class="label stories__eyebrow reveal">
        <span class="stories__rule" aria-hidden="true"></span>
        In production
      </p>
      <h2 class="h2 stories__title reveal" style="--reveal-delay:60ms">
        Sovereign AI already running at enterprises
      </h2>
      <p class="lead stories__lead reveal" style="--reveal-delay:120ms">
        Not pilots. Sovereign AI deployments running full functions, end
        to end, at real enterprise scale.
      </p>
    </div>

    <div class="stories__controls reveal" style="--reveal-delay:180ms">
      <ol class="dots" role="tablist" aria-label="Customer stories">
        {stories.map((s, i) => (
          <li>
            <button
              class="dot-btn"
              type="button"
              role="tab"
              data-dot={i}
              aria-selected={i === 0 ? "true" : "false"}
              aria-label={s.company}
            ><span></span></button>
          </li>
        ))}
      </ol>
      <div class="stories__arrows">
        <button class="arrowbtn" type="button" data-dir="prev" aria-label="Previous story">
          <Fragment set:html={chev("prev")} />
        </button>
        <button class="arrowbtn" type="button" data-dir="next" aria-label="Next story">
          <Fragment set:html={chev("next")} />
        </button>
      </div>
    </div>
  </div>

  <div class="railwrap reveal" style="--reveal-delay:80ms">
    <ol class="rail" tabindex="0" role="group" aria-label="Customer stories, scrollable">
      {copies.map((c) =>
        stories.map((s, i) => (
          <li
            class:list={["story", { "story--featured": s.featured }]}
            data-story={i}
            data-copy={c}
            aria-hidden={c !== 1 ? "true" : undefined}
          >
            <div class="story__head">
              <h3 class="story__company">{s.company}</h3>
              <p class="story__summary">{s.summary}</p>
            </div>

            <blockquote class="story__quote">&ldquo;{s.quote}&rdquo;</blockquote>

            <div class="story__metrics">
              {s.metrics.map((m) => (
                <div class="metric">
                  <p class="metric__value">{m.value}</p>
                  <p class="metric__label">{m.label}</p>
                </div>
              ))}
            </div>

            <ul class="story__tags">
              {s.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </li>
        ))
      )}
    </ol>
  </div>
</section>

<style>
  .stories {
    padding-block: clamp(3.5rem, 1.5rem + 5vw, 7rem);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .stories__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s7);
  }
  .stories__intro { max-width: 46ch; }

  .stories__eyebrow { display: inline-flex; align-items: center; gap: var(--s3); }
  .stories__rule { width: 22px; height: 2px; background: var(--purple); }
  .stories__title { margin-top: var(--s3); max-width: 18ch; }
  .stories__lead  { margin-top: var(--s4); }

  .stories__controls {
    display: flex;
    align-items: center;
    gap: var(--s5);
    flex: none;
    padding-bottom: var(--s1);
  }

  /* Dots, not a progress bar. The rail loops, so there is no start or
     end for a bar to measure against. */
  .dots { display: flex; align-items: center; gap: var(--s2); }
  .dot-btn {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .dot-btn span {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--line-strong);
    transition: width var(--d-mid) var(--ease),
                background var(--d-mid) var(--ease);
  }
  .dot-btn:hover span { background: var(--ink-45); }
  .dot-btn[aria-selected="true"] span {
    width: 18px;
    background: var(--purple);
  }

  .stories__arrows { display: flex; gap: var(--s2); }
  .arrowbtn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--d-fast) var(--ease),
                background var(--d-fast) var(--ease);
  }
  .arrowbtn svg { width: 16px; height: 16px; }
  .arrowbtn:hover { border-color: var(--ink); background: var(--wash); }

  /* Rail --------------------------------------------------------- */
  .railwrap { position: relative; }

  .rail {
    --edge: max(var(--gutter), calc((100% - var(--shell)) / 2 + var(--gutter)));

    display: flex;
    gap: var(--s4);
    margin-top: clamp(2rem, 1rem + 2.5vw, 3rem);
    padding-inline: var(--edge) var(--gutter);
    padding-block: var(--s3);
    /* overflow-x:auto alone makes the browser compute overflow-y:auto,
       turning the vertical padding into a scrollable strip inside the
       component. Pin the vertical axis; the padding still gives the
       hover shadow room. */
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail.is-dragging { cursor: grabbing; scroll-behavior: auto !important; }
  /* While dragging, stop the pointer selecting quote text under it. */
  .rail.is-dragging * { user-select: none; }

  .story {
    flex: none;
    width: clamp(292px, 28vw, 400px);
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 1.4vw, 2rem);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    transition: border-color var(--d-mid) var(--ease),
                box-shadow var(--d-mid) var(--ease),
                transform var(--d-mid) var(--ease);
  }
  .story:hover {
    border-color: rgba(116, 88, 232, 0.4);
    box-shadow: 0 10px 30px -18px rgba(19, 17, 42, 0.3);
  }

  /* One story carries the dark treatment, so the rail has an anchor
     the eye returns to as it loops. */
  .story--featured {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .story--featured:hover {
    border-color: var(--purple);
    box-shadow: 0 14px 36px -18px rgba(19, 17, 42, 0.5);
  }
  .story--featured .story__head { border-bottom-color: rgba(255, 255, 255, 0.14); }
  .story--featured .story__summary { color: rgba(255, 255, 255, 0.6); }
  .story--featured .story__quote { color: rgba(255, 255, 255, 0.78); }
  .story--featured .metric__value { color: var(--paper); }
  .story--featured .metric__label { color: rgba(255, 255, 255, 0.5); }
  .story--featured .story__tags { border-top-color: rgba(255, 255, 255, 0.14); }
  .story--featured .tag {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.86);
  }

  .story__head {
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--line);
  }
  .story__company {
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .story__summary {
    margin-top: var(--s2);
    font-size: var(--t-small);
    color: var(--ink-45);
  }

  .story__quote {
    margin-top: var(--s5);
    color: var(--ink-70);
    text-wrap: pretty;
  }

  .story__metrics {
    display: flex;
    gap: var(--s6);
    margin-top: auto;
    padding-top: var(--s6);
  }
  .metric__value {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--purple-ink);
  }
  .metric__label {
    margin-top: var(--s2);
    font-size: var(--t-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .story__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }
  .tag {
    padding: 4px var(--s3);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--wash);
    font-size: var(--t-label);
    font-weight: 500;
    color: var(--ink-70);
  }

  @media (max-width: 760px) {
    .stories__head { flex-direction: column; align-items: flex-start; gap: var(--s5); }
    .stories__controls { padding-bottom: 0; }
    .story { width: min(84vw, 340px); }
  }
</style>

<script>
  import { stories } from "../data/stories";

  const rail = document.querySelector<HTMLElement>(".stories .rail");
  if (rail) {
    const cards = [...rail.querySelectorAll<HTMLElement>("[data-story]")];
    const dots = [...document.querySelectorAll<HTMLButtonElement>(".stories [data-dot]")];
    const prev = document.querySelector<HTMLButtonElement>('.stories [data-dir="prev"]')!;
    const next = document.querySelector<HTMLButtonElement>('.stories [data-dir="next"]')!;

    const COUNT = stories.length;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Offsets measured from the first card, so they are stable scroll
    // coordinates. Reading live rects instead samples mid-flight
    // positions during a smooth scroll and lands on the wrong card.
    const base = cards[0].offsetLeft;
    const offsetOf = (i: number) => cards[i].offsetLeft - base;
    const setWidth = () => offsetOf(COUNT);

    let index = COUNT; // start in the middle copy

    function paintDots() {
      const active = ((index % COUNT) + COUNT) % COUNT;
      dots.forEach((d, i) =>
        d.setAttribute("aria-selected", String(i === active))
      );
    }

    /** Shift by whole sets so the reader is always inside the middle
     *  copy. The jump is exactly one set wide, so nothing moves on
     *  screen. */
    function recentre() {
      const w = setWidth();
      if (!w) return;
      let shifted = false;
      while (rail.scrollLeft < w * 0.5) { rail.scrollLeft += w; index += COUNT; shifted = true; }
      while (rail.scrollLeft > w * 1.5) { rail.scrollLeft -= w; index -= COUNT; shifted = true; }
      return shifted;
    }

    function goTo(i: number, smooth = true) {
      index = i;
      rail.scrollTo({ left: offsetOf(index), behavior: smooth && !reduce ? "smooth" : "auto" });
      paintDots();
    }

    prev.addEventListener("click", () => goTo(index - 1));
    next.addEventListener("click", () => goTo(index + 1));

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        // Travel to the nearest copy of that story, so a dot press
        // never scrolls the long way round.
        const current = ((index % COUNT) + COUNT) % COUNT;
        let delta = i - current;
        if (delta > COUNT / 2) delta -= COUNT;
        if (delta < -COUNT / 2) delta += COUNT;
        goTo(index + delta);
      });
    });

    rail.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      goTo(index + (e.key === "ArrowRight" ? 1 : -1));
    });

    // Drag to scroll. A native scroll container gives touch and
    // trackpad for free but ignores a mouse drag, which is the gesture
    // people reach for on a rail like this.
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = 0;

    rail.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startScroll = rail.scrollLeft;
      rail.classList.add("is-dragging");
      rail.setPointerCapture(e.pointerId);
    });

    rail.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      rail.scrollLeft = startScroll - dx;
    });

    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      rail.classList.remove("is-dragging");
      if (rail.hasPointerCapture(e.pointerId)) rail.releasePointerCapture(e.pointerId);
      recentre();
      index = nearest();
      paintDots();
    };
    rail.addEventListener("pointerup", endDrag);
    rail.addEventListener("pointercancel", endDrag);
    // A drag that ends over a link should not also count as a click.
    rail.addEventListener("click", (e) => { if (moved > 4) e.preventDefault(); }, true);

    function nearest() {
      let best = 0;
      let dist = Infinity;
      for (let i = 0; i < cards.length; i++) {
        const d = Math.abs(offsetOf(i) - rail.scrollLeft);
        if (d < dist) { dist = d; best = i; }
      }
      return best;
    }

    let settle = 0;
    rail.addEventListener(
      "scroll",
      () => {
        clearTimeout(settle);
        settle = window.setTimeout(() => {
          if (dragging) return;
          recentre();
          index = nearest();
          paintDots();
        }, 140);
      },
      { passive: true }
    );

    // Start in the middle copy without animating there.
    requestAnimationFrame(() => {
      rail.scrollTo({ left: offsetOf(index), behavior: "auto" });
      paintDots();
    });
  }
</script>
