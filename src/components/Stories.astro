---
import { stories } from "../data/stories";

const chev = (dir: "prev" | "next") =>
  `<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="${
    dir === "prev" ? "M9.6 3.6 5.2 8l4.4 4.4" : "M6.4 3.6 10.8 8l-4.4 4.4"
  }" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="stories" id="stories">
  <div class="shell stories__head">
    <div class="stories__intro">
      <p class="label stories__eyebrow reveal">
        <span class="stories__rule" aria-hidden="true"></span>
        In production
      </p>
      <h2 class="h2 stories__title reveal" style="--reveal-delay:60ms">
        Sovereign AI already running at enterprises
      </h2>
      <p class="lead stories__lead reveal" style="--reveal-delay:120ms">
        Not pilots. Sovereign AI deployments running full functions, end
        to end, at real enterprise scale.
      </p>
    </div>

    <div class="stories__controls reveal" style="--reveal-delay:180ms">
      <div class="progress" aria-hidden="true">
        <span class="progress__thumb" data-thumb></span>
      </div>
      <div class="stories__arrows">
        <button class="arrowbtn" type="button" data-dir="prev" aria-label="Previous story" disabled>
          <Fragment set:html={chev("prev")} />
        </button>
        <button class="arrowbtn" type="button" data-dir="next" aria-label="Next story">
          <Fragment set:html={chev("next")} />
        </button>
      </div>
    </div>
  </div>

  <!-- A real scroll container, so trackpad, touch and keyboard all work.
       It bleeds past the shell on the right, which is what tells you
       there is more without needing a scrollbar. -->
  <ol
    class="rail"
    tabindex="0"
    role="group"
    aria-label="Customer stories, scrollable"
  >
    {stories.map((s, i) => (
      <li class="story reveal" data-story={i} style={`--reveal-delay:${i * 70}ms`}>
        <div class="story__head">
          <h3 class="story__company">{s.company}</h3>
          <p class="story__summary">{s.summary}</p>
        </div>

        <blockquote class="story__quote">&ldquo;{s.quote}&rdquo;</blockquote>

        <div class="story__metrics">
          {s.metrics.map((m) => (
            <div class="metric">
              <p class="metric__value">{m.value}</p>
              <p class="metric__label">{m.label}</p>
            </div>
          ))}
        </div>

        <ul class="story__tags">
          {s.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</section>

<style>
  .stories {
    padding-block: clamp(3.5rem, 1.5rem + 5vw, 7rem);
    border-top: 1px solid var(--line);
    /* the rail bleeds; nothing else should */
    overflow: hidden;
  }

  .stories__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s7);
  }
  .stories__intro { max-width: 46ch; }

  .stories__eyebrow { display: inline-flex; align-items: center; gap: var(--s3); }
  .stories__rule {
    width: 22px;
    height: 2px;
    background: var(--purple);
  }
  .stories__title { margin-top: var(--s3); max-width: 18ch; }
  .stories__lead  { margin-top: var(--s4); }

  .stories__controls {
    display: flex;
    align-items: center;
    gap: var(--s5);
    flex: none;
    padding-bottom: var(--s1);
  }
  /* A proportional indicator rather than an "n of 5" counter. The rail
     scrolls continuously and the last card never becomes the leftmost,
     so a count would claim a position the rail never reaches. */
  .progress {
    position: relative;
    width: clamp(80px, 9vw, 132px);
    height: 3px;
    border-radius: 3px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .progress__thumb {
    position: absolute;
    inset-block: 0;
    left: 0;
    border-radius: 3px;
    background: var(--purple);
    transform-origin: left;
  }

  .stories__arrows { display: flex; gap: var(--s2); }
  .arrowbtn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--d-fast) var(--ease),
                background var(--d-fast) var(--ease),
                opacity var(--d-fast) var(--ease);
  }
  .arrowbtn svg { width: 16px; height: 16px; }
  .arrowbtn:hover:not(:disabled) { border-color: var(--ink); background: var(--wash); }
  .arrowbtn:disabled { opacity: 0.32; cursor: default; }

  /* Rail --------------------------------------------------------- */
  .rail {
    /* Left edge lines up with the shell; the right runs off screen. */
    --edge: max(var(--gutter), calc((100% - var(--shell)) / 2 + var(--gutter)));

    display: flex;
    gap: var(--s4);
    margin-top: clamp(2rem, 1rem + 2.5vw, 3rem);
    padding-inline: var(--edge) var(--gutter);
    padding-block: var(--s3);
    /* overflow-x:auto alone makes the browser compute overflow-y:auto,
       which turned the vertical padding into a tiny scrollable strip
       inside the rail. Pin the vertical axis shut; the padding still
       gives the hover shadow room to show. */
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    /* No scroll-snap. Once the trailing cards fit on screen, their
       snap positions sit past the maximum scroll, and the browser
       snaps backwards to the last reachable one, dragging the rail off
       the end on its own. The buttons already land on exact card
       offsets, so snapping bought nothing and cost correctness. */
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail:focus-visible { outline-offset: -2px; }

  .story {
    flex: none;
    width: clamp(292px, 28vw, 400px);
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 1.4vw, 2rem);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    transition: border-color var(--d-mid) var(--ease),
                box-shadow var(--d-mid) var(--ease);
  }
  .story:hover {
    border-color: rgba(116, 88, 232, 0.4);
    box-shadow: 0 10px 30px -18px rgba(19, 17, 42, 0.3);
  }

  .story__head {
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--line);
  }
  .story__company {
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .story__summary {
    margin-top: var(--s2);
    font-size: var(--t-small);
    color: var(--ink-45);
  }

  .story__quote {
    margin-top: var(--s5);
    color: var(--ink-70);
    text-wrap: pretty;
  }

  /* Pushes the metrics and tags to the bottom, so those rows line up
     across cards even though the quotes are different lengths. */
  .story__metrics {
    display: flex;
    gap: var(--s6);
    margin-top: auto;
    padding-top: var(--s6);
  }
  .metric__value {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--purple-ink);
  }
  .metric__label {
    margin-top: var(--s2);
    font-size: var(--t-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-45);
  }

  .story__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--line);
  }
  /* Same chips as the capabilities named in the governance matrix, so
     the proof visibly points back at the product. */
  .tag {
    padding: 4px var(--s3);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--wash);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--ink-70);
  }

  @media (max-width: 760px) {
    .stories__head { flex-direction: column; align-items: flex-start; gap: var(--s5); }
    .stories__controls { padding-bottom: 0; }
    .story { width: min(84vw, 340px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail { scroll-behavior: auto; }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>(".stories .rail");
  if (rail) {
    const cards = [...rail.querySelectorAll<HTMLElement>("[data-story]")];
    const prev = document.querySelector<HTMLButtonElement>('.stories [data-dir="prev"]')!;
    const next = document.querySelector<HTMLButtonElement>('.stories [data-dir="next"]')!;
    const thumb = document.querySelector<HTMLElement>(".stories [data-thumb]")!;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const behavior: ScrollBehavior = reduce ? "auto" : "smooth";

    // Card positions measured from the first card, so they are stable
    // scroll coordinates. Reading live bounding rects instead would
    // sample mid-flight positions during a smooth scroll and land on
    // the wrong card.
    const offsetOf = (i: number) => cards[i].offsetLeft - cards[0].offsetLeft;

    function nearest() {
      let best = 0;
      let dist = Infinity;
      for (let i = 0; i < cards.length; i++) {
        const d = Math.abs(offsetOf(i) - rail.scrollLeft);
        if (d < dist) { dist = d; best = i; }
      }
      return best;
    }

    const maxScroll = () => rail.scrollWidth - rail.clientWidth;

    // The buttons step a tracked index rather than recomputing position
    // from scrollLeft on every click. Reading scrollLeft mid-flight,
    // while a smooth scroll or a snap adjustment is still settling,
    // lands on the wrong card. Manual scrolling re-syncs the index once
    // it has come to rest.
    let index = 0;

    function sync() {
      const max = maxScroll();
      // Thumb length is the share of the rail on screen; its offset is
      // how far through that share we are.
      const share = Math.min(1, rail.clientWidth / rail.scrollWidth);
      const travel = max > 0 ? rail.scrollLeft / max : 0;
      const track = thumb.parentElement!.clientWidth;
      const len = Math.max(18, track * share);
      thumb.style.width = `${len}px`;
      thumb.style.transform = `translateX(${travel * (track - len)}px)`;

      // Compare against real scroll extents, so the arrows disable at
      // the true ends rather than at a card index we guessed.
      prev.disabled = rail.scrollLeft <= 1;
      next.disabled = rail.scrollLeft >= max - 1;
    }

    function go(delta: number) {
      index = Math.min(cards.length - 1, Math.max(0, index + delta));
      // Never ask for a position past the end; the last cards' offsets
      // exceed the maximum scroll once they all fit on screen.
      rail.scrollTo({ left: Math.min(offsetOf(index), maxScroll()), behavior });
    }

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));

    rail.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      go(e.key === "ArrowRight" ? 1 : -1);
    });

    let frame = 0;
    let settle = 0;
    rail.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
        // Once the rail rests, adopt wherever the reader left it.
        clearTimeout(settle);
        settle = window.setTimeout(() => { index = nearest(); }, 160);
      },
      { passive: true }
    );
    window.addEventListener("resize", sync, { passive: true });
    sync();
  }
</script>
