---
import PartnerLogos from "./PartnerLogos.astro";

const layers = [
  {
    name: "Lyzr Agent Platform",
    desc: "Agentic OS and Control Plane. One governance layer.",
    status: "Live",
    tone: "live",
  },
  {
    name: "Lyzr Nitro",
    desc: "Production modules for Bedrock, Foundry and Vertex.",
    status: "Live",
    tone: "live",
  },
  {
    name: "Lyzr LLMs",
    desc: "Open source models built for responsible AI.",
    status: "Coming",
    tone: "soon",
  },
  {
    name: "Lyzr Optimus",
    desc: "On-prem appliance. Air-gapped. No external calls.",
    status: "Shipping Q4",
    tone: "soon",
    featured: true,
  },
];
---

<section class="hero">
  <div class="shell">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="label reveal">Sovereign AI</p>

        <h1 class="display hero__title reveal" style="--reveal-delay:60ms">
          The Sovereign AI platform for leading enterprises
        </h1>

        <p class="lead hero__lead reveal" style="--reveal-delay:120ms">
          Your agents, your models, your hardware, your governance. The
          full-stack sovereign agent platform &mdash; every layer Lyzr,
          every layer yours.
        </p>

        <div class="hero__actions reveal" style="--reveal-delay:180ms">
          <a class="btn btn--primary" href="#optimus">
            Pre-order Optimus <span class="arrow">&rarr;</span>
          </a>
          <a class="btn btn--ghost" href="#cta">Talk to us</a>
        </div>
      </div>

      <div class="hero__visual reveal" style="--reveal-delay:220ms">
        <div class="stack" aria-label="The Lyzr sovereign AI stack">
          <div class="stack__head">
            <span class="label">The stack</span>
            <span class="stack__count">Four layers, all yours</span>
          </div>

          <ul class="stack__list">
            {layers.map((layer, i) => (
              <li class:list={["layer", { "layer--featured": layer.featured }]} style={`--i:${i}`}>
                <div class="layer__top">
                  <span class="layer__name">{layer.name}</span>
                  <span class={`pill pill--${layer.tone}`}>
                    {layer.tone === "live" && <span class="dot" />}
                    {layer.status}
                  </span>
                </div>
                <p class="layer__desc">{layer.desc}</p>
              </li>
            ))}
          </ul>

          <p class="stack__foot">Nothing leaves your walls.</p>
        </div>
      </div>
    </div>

    <div class="hero__trust reveal" style="--reveal-delay:120ms">
      <PartnerLogos />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.75rem, 1.25rem + 5vw, 5rem)
                   clamp(3rem, 1.5rem + 5.5vw, 5.5rem);
    /* One soft purple bloom, anchored top-left, used once on the page. */
    background: radial-gradient(
      100% 80% at 4% -10%,
      rgba(116, 88, 232, 0.17) 0%,
      rgba(116, 88, 232, 0) 58%
    );
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 1rem + 5vw, 5rem);
    align-items: center;
  }

  /* 17ch settles the headline into three full lines instead of four
     ragged ones. */
  .hero__title { margin-top: var(--s4); max-width: 17ch; }
  .hero__lead  { margin-top: var(--s5); max-width: 46ch; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s6);
  }

  /* The trust row spans the full shell so the right column has no
     empty quadrant beneath it. */
  .hero__trust { margin-top: clamp(2.5rem, 1rem + 4vw, 4.5rem); }

  /* Stack visual ------------------------------------------------ */
  .stack {
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--paper);
    padding: var(--s5);
    box-shadow: 0 1px 2px rgba(19, 17, 42, 0.04);
  }

  .stack__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--line);
  }
  .stack__count {
    font-size: var(--t-small);
    color: var(--ink-45);
  }

  .stack__list { display: grid; margin-top: 1px; }

  .layer {
    padding: var(--s4) var(--s3);
    border-bottom: 1px solid var(--line);
    position: relative;
    transition: background var(--d-mid) var(--ease);
  }
  /* The purple rule appears only on hover, so the card rests quiet. */
  .layer::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--purple);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--d-mid) var(--ease);
  }
  .layer:hover { background: var(--wash); }
  .layer:hover::before { transform: scaleY(1); }

  /* Optimus is what the hero button sells, so it carries the rule
     at rest and the eye lands there first. */
  .layer--featured { background: var(--wash); }
  .layer--featured::before { transform: scaleY(1); }

  .layer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
  }
  .layer__name { font-weight: 600; letter-spacing: -0.018em; }
  .layer__desc {
    margin-top: var(--s1);
    font-size: var(--t-small);
    color: var(--ink-45);
    max-width: 42ch;
  }

  .stack__foot {
    margin-top: var(--s4);
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--purple-ink);
  }

  @media (max-width: 940px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__title { max-width: 19ch; }
  }
</style>
