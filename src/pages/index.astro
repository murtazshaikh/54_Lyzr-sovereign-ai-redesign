---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import CustomerWall from "../components/CustomerWall.astro";
import StatBand from "../components/StatBand.astro";
import WhyItMatters from "../components/WhyItMatters.astro";
import PathToSovereign from "../components/PathToSovereign.astro";
import FullStack from "../components/FullStack.astro";
import OptimusScale from "../components/OptimusScale.astro";
import Governance from "../components/Governance.astro";
import Stories from "../components/Stories.astro";
import Testimonials from "../components/Testimonials.astro";
import Trust from "../components/Trust.astro";
import Resources from "../components/Resources.astro";
import FounderQuote from "../components/FounderQuote.astro";
import ClosingCta from "../components/ClosingCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Base
  title="Sovereign AI, a concept redesign | Murtaza Shaikh"
  description="An independent concept redesign of Lyzr's Sovereign AI page, in Ramp's design language. Built with Astro and no client-side framework."
>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <CustomerWall />
    <StatBand />
    <WhyItMatters />
    <PathToSovereign />
    <FullStack />
    <OptimusScale />
    <Governance />
    <Stories />
    <Testimonials />
    <Trust />
    <Resources />
    <FounderQuote />
    <ClosingCta />
  </main>
  <SiteFooter />
</Base>
